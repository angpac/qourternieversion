<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)net.criers.Qourt.shared</string>
	</array>
	<!-- Names the App Clip embedded in this app. The association has to be
	     declared from both ends: the clip points up at its parent with
	     com.apple.developer.parent-application-identifiers, and this points
	     back down. Without it App Store Connect rejects the upload with
	     "Missing entitlement ... com.apple.developer.associated-appclip-app-identifiers". -->
	<key>com.apple.developer.associated-appclip-app-identifiers</key>
	<array>
		<string>$(AppIdentifierPrefix)net.criers.Qourt.Clip</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:qourt-web.vercel.app</string>
	</array>
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
